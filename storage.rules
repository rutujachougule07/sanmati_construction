rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /site_photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024; // 10MB max photo
    }
    match /documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024; // 25MB max doc
    }
  }
}
