# SANMATI CONSTRUCTIONS ERP - Frontend Environment Configuration
VITE_APP_NAME="SANMATI CONSTRUCTIONS ERP"
VITE_COMPANY_LOCATION="Kolhapur, Maharashtra, India"

# Firebase Client Configuration
# (If not provided, the ERP automatically activates a rich simulated Firestore engine for testing)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Google Maps API Key (Optional: Leaflet with OpenStreetMap is pre-configured and active by default)
VITE_GOOGLE_MAPS_API_KEY=""

# Backend API Endpoint
VITE_API_URL="/api"
